Package: marqLevAlg
Type: Package
Title: A Parallelized General-Purpose Optimization Based on Marquardt-Levenberg Algorithm
Version: 2.0.8
Date: 2023-03-22
Authors@R: c(person("Viviane", "Philipps", role = c("aut", "cre"), email = "viviane.philipps@u-bordeaux.fr"),
